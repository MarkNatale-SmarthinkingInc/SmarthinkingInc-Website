# Copy to .env.local and fill in from the hosting provider (Vercel project
# settings). .env.local is git-ignored and stays on your machine.

# Optional. Base URL for metadata (metadataBase in src/utils/seo.ts).
# Set in Vercel for deployed environments; locally it falls back to
# VERCEL_URL and then http://localhost:3000, so a blank value is fine.
NEXT_PUBLIC_SITE_URL=

# Optional. Overrides the Prismic repository name.
# Blank falls back to slicemachine.config.json (smartthinking-cms).
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=

# Mailchimp (newsletter signup)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Shared secret for the Prismic content webhook (src/app/api/revalidate).
# Must match the "Secret" field on the webhook in Prismic. The endpoint
# refuses every request unless this is set, so it is required in production.
PRISMIC_WEBHOOK_SECRET=

# Contact form (src/app/api/contact). Submissions go to Jotform via its API;
# the key comes from Jotform > Settings > API (Full Access).
JOTFORM_API_KEY=

# Cloudflare Turnstile (spam check on the contact form). Both come from the
# Turnstile widget in the Cloudflare dashboard. For local testing, Cloudflare's
# always-pass test keys work: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
