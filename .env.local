# Local environment variables — NOT committed (see .gitignore).
# Copy real values from your hosting provider (e.g. Vercel project settings).

# Required for builds: used as metadataBase in src/utils/seo.ts.
# Must be a full, valid URL or `new URL()` will throw and the build fails.
NEXT_PUBLIC_SITE_URL=https://www.smarthinkinginc.com

# Optional: overrides the Prismic repository name.
# Leave blank to fall back to slicemachine.config.json (smartthinking-cms).
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=

# Mailchimp (contact / signup forms)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_CONTACT_FORM_AUDIENCE_ID=
